{
  "name": "@holu/authjs",
  "type": "module",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "homepage": "https://holujs.github.io/en/",
  "description": "Holu module to support Auth.js",
  "module": "dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "yarn build-test && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs",
    "build-test": "tsc -b tsconfig.e2e.json"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts"
    }
  },
  "imports": {
    "#mod/*": "./dist/*"
  },
  "keywords": [
    "holu",
    "auth.js",
    "authjs",
    "auth",
    "oauth2",
    "authentication",
    "oidc",
    "csrf"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@auth/core": "^0.41.3"
  },
  "peerDependencies": {
    "@holu/body-parser": "^0.2.1",
    "@holu/core": "^0.2.1",
    "@holu/rest": "^0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
