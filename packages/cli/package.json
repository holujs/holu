{
  "name": "@holu/cli",
  "type": "module",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "homepage": "https://holujs.github.io/en/",
  "description": "CLI tool for Holu framework development",
  "module": "dist/index.js",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "holu": "dist/holu.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "tsc -b tsconfig.unit.json && yarn esm-jest",
    "build-test": "tsc -b tsconfig.build.json",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "keywords": [
    "holu",
    "cli",
    "holu-cli"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "typescript": ">=5.0.0 <7.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
