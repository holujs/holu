{
  "name": "@holu/i18n",
  "type": "module",
  "version": "0.2.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "description": "Holu module to integration with i18n (internalization)",
  "module": "dist/index.js",
  "scripts": {
    "test": "yarn build-test && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs",
    "build-test": "tsc -b tsconfig.e2e.json",
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*"
  },
  "imports": {
    "#types/*": "./dist/types/*",
    "#src/*": "./dist/*"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "keywords": [
    "holu"
  ],
  "author": "Костя Третяк",
  "license": "MIT",
  "peerDependencies": {
    "@holu/core": "^0.2.1",
    "@holu/rest": "^0.2.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
