{
  "private": true,
  "name": "@holu/sqb",
  "type": "module",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/holujs/holu.git",
    "directory": "packages/sqb"
  },
  "description": "Holu module to simplify the building SQL queries to the database.",
  "module": "dist/index.js",
  "imports": {
    "#app/*": "./dist/app/*",
    "#decorators/*": "./dist/decorators/*"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "tsc -b tsconfig.unit.json && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "keywords": [
    "holu"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@holu/core": "^0.2.1",
    "@holu/rest": "^0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
