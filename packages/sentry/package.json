{
  "name": "@holu/sentry",
  "type": "module",
  "version": "0.2.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "homepage": "https://holujs.github.io/en/",
  "description": "Holu module to support...",
  "module": "dist/index.js",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "tsc -b tsconfig.e2e.json && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "keywords": [
    "holu",
    "sentry"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@holu/core": "^0.2.1",
    "@holu/rest": "^0.2.1"
  },
  "dependencies": {
    "@sentry/core": "^10.68.0",
    "@sentry/node": "^10.68.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
