{
  "name": "@holu/core",
  "type": "module",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "homepage": "https://holujs.github.io/en/",
  "description": "NodeJS web framework writen in TypeScript",
  "module": "dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "yarn build-test && yarn esm-jest",
    "build-test": "tsc -b tsconfig.unit.json",
    "clean": "rm -rf dist*",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "imports": {
    "#di/*": "./dist/di/*",
    "#ctx/*": "./dist/ctx/*",
    "#init/*": "./dist/init/*",
    "#types/*": "./dist/types/*",
    "#utils/*": "./dist/utils/*",
    "#models/*": "./dist/models/*",
    "#decorators/*": "./dist/decorators/*",
    "#logger/*": "./dist/logger/*",
    "#errors": "./dist/errors.js",
    "#error/*": "./dist/error/*",
    "#services/*": "./dist/services/*",
    "#extension/*": "./dist/extension/*",
    "#interceptors/*": "./dist/interceptors/*"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./di": {
      "types": "./dist/di.d.ts",
      "default": "./dist/di.js"
    },
    "./decorators": {
      "types": "./dist/decorators.d.ts",
      "default": "./dist/decorators.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "keywords": [
    "holu"
  ],
  "author": "Костя Третяк <ktretiak.in.ua@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">= 24.0.0"
  },
  "dependencies": {
    "@ts-stack/chain-error": "^1.5.1",
    "reflect-metadata": "^0.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
