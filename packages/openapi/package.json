{
  "name": "@holu/openapi",
  "type": "module",
  "version": "0.2.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/holujs/holu.git",
    "directory": "packages/openapi"
  },
  "description": "This is module for Holu framework to support OpenAPI",
  "module": "dist/index.js",
  "imports": {
    "#types/*": "./dist/types/*",
    "#utils/*": "./dist/utils/*",
    "#decorators/*": "./dist/decorators/*",
    "#services/*": "./dist/services/*",
    "#constants": "./dist/constants.js",
    "#errors": "./dist/errors.js"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build-ui": "yarn build && node dist/swagger-ui/compile.js",
    "clean": "rm -rf dist*",
    "build-test": "tsc -b tsconfig.unit.json",
    "test": "yarn build-test && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "keywords": [
    "holu"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ts-stack/openapi-spec": "^3.1.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/swagger-ui": "^5.32.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "json-loader": "^0.5.7",
    "style-loader": "^4.0.0",
    "swagger-ui": "~5.27.1",
    "typescript-7": "npm:typescript@^7.0.2",
    "webpack": "^5.109.0",
    "yaml-loader": "^0.9.0"
  },
  "peerDependencies": {
    "@holu/core": "^0.2.1",
    "@holu/rest": "^0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
