{
  "name": "@holu/typeorm",
  "type": "module",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "homepage": "https://holujs.github.io/en/",
  "description": "Holu module to support TypeORM",
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "yarn build-test && yarn esm-jest",
    "build-test": "tsc -b tsconfig.e2e.json",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "keywords": [
    "holu",
    "typeorm",
    "orm"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@holu/core": "^0.1.0",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typeorm": "^1.1.0",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
