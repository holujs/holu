{
  "name": "@holu/cors",
  "type": "module",
  "version": "0.2.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "description": "Holu module to support CORS and OPTIONS requests",
  "module": "dist/index.js",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsc -b tsconfig.unit.json && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs",
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*"
  },
  "keywords": [
    "holu",
    "cors",
    "options"
  ],
  "author": "Костя Третяк",
  "license": "MIT",
  "dependencies": {
    "@ts-stack/cookies": "^1.2.2",
    "@ts-stack/cors": "^1.4.2"
  },
  "peerDependencies": {
    "@holu/core": "^0.2.1",
    "@holu/rest": "^0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
