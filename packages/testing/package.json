{
  "private": true,
  "name": "@holu/testing",
  "type": "module",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holujs/holu.git"
  },
  "description": "This is a module for Holu applications",
  "module": "dist/index.js",
  "imports": {
    "#app/*": "./dist/*"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "tsc -b tsconfig.unit.json && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs",
    "rebuild": "cd ../.. && yarn clean && cd - && yarn build"
  },
  "keywords": [
    "holu"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@holu/core": "^0.2.1",
    "@holu/rest": "^0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
